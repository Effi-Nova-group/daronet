---
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description, bodyClass = "body", noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();

// Trailing-slash-insensitive current-section match for nav highlighting
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<!DOCTYPE html>
<html data-wf-page="6a576ec21f9b918f8374cdac" data-wf-site="6a576ec01f9b918f8374cd15">
<head>
  <meta charset="utf-8">
  <title>{title}</title>
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <meta name="google-site-verification" content="s5cn3ekVVNYrQJDY3AAgjWGBWVCNsnPFvIuGEtNUUkc" />
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonicalURL}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonicalURL}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  {description && <meta name="twitter:description" content={description} />}
  <meta content="Webflow" name="generator">
  <link href="/css/normalize.css" rel="stylesheet" type="text/css">
  <link href="/css/webflow.css" rel="stylesheet" type="text/css">
  <link href="/css/daronet.webflow.css" rel="stylesheet" type="text/css">
  <script type="text/javascript" is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  <link rel="icon" type="image/png" href="/images/favicon-main.png" sizes="any">
  <link rel="apple-touch-icon" href="/images/favicon-main.png">
</head>
<body class={bodyClass}>
  <div class="page-wrapper">
    <div data-animation="over-left" class="header w-nav" data-easing2="ease" data-easing="ease" data-collapse="medium" role="banner" data-duration="400">
      <div class="container-default w-container">
        <div class="header-wrapper">
          <div class="split-content header-right">
            <a href="/" class="brand w-nav-brand"><img src="/images/Group-1.png" alt="Daronet" class="header-logo"></a>
          </div>
          <div class="split-content header-center">
            <nav role="navigation" class="nav-menu w-nav-menu">
              <ul role="list" class="header-navigation w-list-unstyled">
                <li class="nav-item-wrapper">
                  <a href="/" class="nav-link" aria-current={isCurrent("/") ? "page" : undefined}>Home</a>
                </li>
                <li class="nav-item-wrapper">
                  <a href="/#about" class="nav-link">About</a>
                </li>
                <li class="nav-item-wrapper">
                  <a href="/case-studies" class="nav-link" aria-current={isCurrent("/case-studies") ? "page" : undefined}>Case Studies</a>
                </li>
                <li class="nav-item-wrapper">
                  <a href="/blog" class="nav-link" aria-current={isCurrent("/blog") ? "page" : undefined}>Blogs</a>
                </li>
                <li class="nav-item-wrapper">
                  <a href="/#contact" class="nav-link">Contact</a>
                </li>
                <li class="nav-item-wrapper mobile-button">
                  <div class="button-primary-gradient header-button mobile-button">
                    <a href="/#contact" class="button-primary small-v2 mobile-button w-button">Book a Strategy Call</a>
                  </div>
                </li>
              </ul>
            </nav>
          </div>
          <div class="split-content header-left">
            <div class="button-primary-gradient header-button">
              <a href="/#contact" class="button-primary small-v2 w-button">Book a Strategy Call</a>
            </div>
            <div class="menu-button w-nav-button">
              <div class="header-menu-button-icon-wrapper">
                <div class="icon-wrapper">
                  <div class="header-menu-button-icon-top"></div>
                  <div class="header-menu-button-icon-medium"></div>
                  <div class="header-menu-button-icon-bottom"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <main class="main-wrapper">
      <slot />
      <footer class="footer_component">
        <div class="padding-global-2">
          <div class="container-large-2">
            <div class="padding-vertical padding-xxlarge">
              <div class="padding-bottom padding-xxlarge">
                <div class="footer7_top-wrapper">
                  <a href="/" class="footer7_logo-link w-nav-brand"><img loading="lazy" src="/images/Group-1.png" alt="Daronet" class="footer7_logo"></a>
                </div>
              </div>
              <div class="divider-horizontal"></div>
              <div class="padding-top padding-medium">
                <div class="footer7_bottom-wrapper">
                  <div class="footer7_credit-text">© 2026 Daronet. All rights reserved.</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </footer>
    </main>
  </div>
  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6a576ec01f9b918f8374cd15" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous" is:inline></script>
  <script src="/js/webflow.js" type="text/javascript" is:inline></script>
</body>
</html>

<style>
  /* Nav: the current page reads at full strength, the rest sit muted.
     Scoped with .header-navigation to win over .nav-link in daronet.webflow.css. */
  .header-navigation .nav-link { color: rgba(255,255,255,0.65); }
  .header-navigation .nav-link:hover,
  .header-navigation .nav-link:focus-visible { color: #fff; }
  .header-navigation .nav-link[aria-current="page"] { color: #fff; font-weight: 600; }

  /* .header-wrapper is a space-between flex row (logo | links | CTA). Equalised gaps
     push the links off true centre because the logo (160px) and the CTA button are
     different widths, so pin the link group to the centre instead. */
  @media (min-width: 992px) {
    .header-wrapper { position: relative; }
    .header-wrapper .split-content.header-center {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
    .header-navigation { justify-content: center; }
    /* Webflow's 32px right margin leaves a trailing gap on the last item */
    .header-navigation .nav-item-wrapper:last-child { margin-right: 0; }
  }

  /* Five links now sit beside the logo and the CTA. Step the gap down so the inline
     row still fits all the way to Webflow's 991px collapse breakpoint. */
  @media (min-width: 992px) and (max-width: 1180px) {
    .header-navigation .nav-item-wrapper { margin-right: 22px; }
  }
  @media (min-width: 992px) and (max-width: 1040px) {
    .header-navigation .nav-item-wrapper { margin-right: 16px; }
    .header-navigation .nav-link { font-size: 0.94rem; }
  }

  /* Below 992px daronet.webflow.css hides .header-left, which also hid the hamburger,
     leaving the collapsed menu unreachable. Restore it; the CTA inside it keeps its
     own existing rules (visible to 767px, then served by .mobile-button in the panel). */
  @media (max-width: 991px) {
    .header-wrapper .split-content.header-left { display: flex; }
  }
</style>
