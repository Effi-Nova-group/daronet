        <style>
/* Logo marquee (Block 03) */
.logo-marquee-section { padding: 6rem 0; overflow: hidden; }
.logo-marquee-heading { text-align: center; font-size: 1rem; letter-spacing: 0.15em; text-transform: uppercase; opacity: 0.7; margin-bottom: 3rem; }
.logo-marquee { position: relative; width: 100%; padding: 10px 0; overflow: hidden; mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent); }
.logo-marquee__track { display: flex; width: max-content; animation: logo-marquee-scroll 30s linear infinite; }
.logo-marquee__item { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; height: 60px; margin-right: 6rem; }
.logo-marquee__item img { max-height: 100%; width: auto; filter: brightness(0) invert(1); opacity: 0.65; transition: opacity 0.3s ease; }
.logo-marquee:hover .logo-marquee__item img { opacity: 0.5; }
.logo-marquee__item:hover img { opacity: 1; }
/* Keep full-colour logos as-is (no white silhouette) */
.logo-marquee__item--color img { filter: none; opacity: 0.9; }
.logo-marquee:hover .logo-marquee__item--color img { opacity: 0.75; }
.logo-marquee__item--color:hover img { opacity: 1; }
/* Smaller logo variant */
.logo-marquee__item--sm img { max-height: 70%; }
/* Larger logo variant — visual scale only so flex widths stay identical (keeps loop seamless) */
.logo-marquee__item--lg img { transform: scale(1.18); transform-origin: center; }
@keyframes logo-marquee-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .logo-marquee__track { animation: none; justify-content: center; flex-wrap: wrap; width: 100%; } }

/* Theme */
:root { --accent-red: #ff2e4d; --accent-red-2: #ff6a3d; --accent-red-deep: #b8102e; }

/* About redesign (Block 02) — split layout */
.about-block { position: relative; }
.about-block__bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
.about-block__glow { position: absolute; border-radius: 50%; filter: blur(120px); }
.about-block__glow--a { width: 520px; height: 520px; background: var(--accent-red); top: -120px; left: -140px; opacity: 0.28; }
.about-block__glow--b { width: 460px; height: 460px; background: var(--accent-red-2); bottom: -140px; right: -120px; opacity: 0.18; }
.about-block__inner { position: relative; z-index: 1; }
.about-block__eyebrow { display: inline-flex; align-items: center; gap: 0.55rem; font-size: 0.72rem; letter-spacing: 0.25em; text-transform: uppercase; opacity: 0.85; padding: 0.4rem 0.9rem; border: 1px solid rgba(255, 46, 77, 0.35); background: rgba(255, 46, 77, 0.08); border-radius: 999px; margin-bottom: 1.25rem; color: #fff; }
.about-block__eyebrow::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-red); box-shadow: 0 0 12px var(--accent-red); }
.about-block__split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
@media (max-width: 991px) { .about-block__split { grid-template-columns: 1fr; } }
.about-block__intro h2 strong, .about-block__intro h2 { color: #fff; }
.about-block__intro .accent {
  background: linear-gradient(135deg, var(--accent-red), var(--accent-red-2));
  -webkit-background-clip: text;
          background-clip: text;
  -webkit-text-fill-color: transparent;
  color: var(--accent-red); /* fallback */
}

/* Gradient accent for key words in main section headings */
.heading-accent {
  background: linear-gradient(135deg, var(--accent-red), var(--accent-red-2));
  -webkit-background-clip: text;
          background-clip: text;
  -webkit-text-fill-color: transparent;
  color: var(--accent-red); /* fallback */
}

.service-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
@media (max-width: 767px) { .service-grid { grid-template-columns: 1fr; } }
.service-tile { position: relative; padding: 1.75rem; border-radius: 14px; background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.07); transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease; }
.service-tile:hover { border-color: rgba(255, 46, 77, 0.35); background: rgba(255, 46, 77, 0.03); box-shadow: 0 12px 40px -20px rgba(255, 46, 77, 0.5); }
.service-tile__icon { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px; background: linear-gradient(135deg, rgba(255, 46, 77, 0.15), rgba(255, 106, 61, 0.08)); border: 1px solid rgba(255, 46, 77, 0.28); color: var(--accent-red); margin-bottom: 1.1rem; }
.service-tile__icon svg { width: 22px; height: 22px; stroke: currentColor; stroke-width: 1.75; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.service-tile__title { font-size: 1.2rem; font-weight: 700; color: #fff; margin: 0 0 0.45rem; letter-spacing: -0.01em; }
.service-tile__desc { font-size: 0.94rem; line-height: 1.55; color: rgba(255,255,255,0.65); margin: 0; }

/* Contact block full-width tweaks (Block 04) */
.contact_tollfree { text-align: center; margin-bottom: 2.5rem; color: #fff; }
.contact_tollfree-label { font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase; opacity: 0.55; margin-bottom: 0.35rem; color: #fff; }
.contact_tollfree-number { font-size: 1.5rem; font-weight: 600; line-height: 1; letter-spacing: -0.01em; color: #fff; text-decoration: none; display: inline-block; }
.contact_tollfree-number:hover { opacity: 0.85; color: var(--accent-red); }
/* Red-tinted frosted glass wrapper (no red glow) */
.contact_full {
  width: 100%;
  max-width: 1144px; /* matches blog section inner width (1240 - 2*3rem) */
  margin: 0 auto;
  padding: clamp(2rem, 4vw, 3.5rem);
  border-radius: 20px;
  background: linear-gradient(140deg, rgba(255, 46, 77, 0.14), rgba(255, 46, 77, 0.05) 55%, rgba(255, 106, 61, 0.09));
  border: 1px solid rgba(255, 46, 77, 0.22);
  box-shadow: 0 20px 50px -25px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(22px) saturate(140%);
  -webkit-backdrop-filter: blur(22px) saturate(140%);
  position: relative;
  overflow: hidden;
}
.contact_full::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(circle at 15% 0%, rgba(255, 46, 77, 0.18), transparent 55%),
              radial-gradient(circle at 100% 100%, rgba(255, 106, 61, 0.12), transparent 60%);
  pointer-events: none;
  z-index: 0;
}

/* Web3Forms contact form */
.contact-form { position: relative; z-index: 1; width: 100%; color: #fff; }
.contact-form__botcheck { position: absolute; left: -9999px; opacity: 0; pointer-events: none; }
.contact-form__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem 1.5rem; }
.contact-form__field { display: flex; flex-direction: column; gap: 0.5rem; }
.contact-form__field--full { grid-column: 1 / -1; }
.contact-form__label { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.7); font-weight: 600; }
.contact-form__req { color: var(--accent-red); margin-left: 0.25rem; }
.contact-form__input {
  width: 100%;
  padding: 0.9rem 1rem;
  font: inherit;
  font-size: 1rem;
  color: #fff;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 10px;
  outline: none;
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  -webkit-appearance: none;
  appearance: none;
}
.contact-form__input::placeholder { color: rgba(255,255,255,0.35); }
.contact-form__input:hover { border-color: rgba(255,255,255,0.2); }
.contact-form__input:focus { border-color: var(--accent-red); background: rgba(255,46,77,0.05); box-shadow: 0 0 0 3px rgba(255,46,77,0.18); }
.contact-form__input:-webkit-autofill { -webkit-text-fill-color: #fff; -webkit-box-shadow: 0 0 0 1000px rgba(20,4,8,0.95) inset; caret-color: #fff; }
.contact-form__submit-wrap { display: block; width: fit-content; margin: 2rem auto 0; }
/* Reset only what a <button> element needs so it inherits Webflow's .button-primary look
   (dark inner fill + gradient border from .button-primary-gradient.header-button wrapper). */
button.contact-form__submit { border: 0; cursor: pointer; font-family: inherit; -webkit-appearance: none; appearance: none; }
button.contact-form__submit:disabled { opacity: 0.6; cursor: not-allowed; }
.contact-form__result { margin-top: 1rem; font-size: 0.95rem; color: rgba(255,255,255,0.85); min-height: 1.25rem; }
.contact-form__result[data-state="success"] { color: #6ee7a1; }
.contact-form__result[data-state="error"] { color: var(--accent-red); }
@media (max-width: 640px) {
  .contact-form__grid { grid-template-columns: 1fr; gap: 1rem; }
  .contact-form__submit-wrap { display: block; width: 100%; }
  .contact-form__submit { width: 100%; }
}

/* Header CTA in red */
.button-primary-gradient.header-button { background: linear-gradient(135deg, var(--accent-red), var(--accent-red-2)) !important; }

/* Mobile overrides */
@media (max-width: 767px) {
  .heading-hero-text {
    font-size: clamp(3.25rem, 14.5vw, 5rem) !important;
    line-height: 1 !important;
    text-align: left !important;
    padding: 0 1.25rem 2rem 1.25rem !important;
    margin: 0 !important;
    left: 0 !important;
    right: auto !important;
    bottom: 0 !important;
    top: auto !important;
    transform: none !important;
    max-width: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    letter-spacing: -0.03em !important;
    text-shadow: 0 2px 20px rgba(0,0,0,0.55), 0 1px 2px rgba(0,0,0,0.7);
    word-break: normal;
    overflow-wrap: normal;
    hyphens: none;
    z-index: 2;
  }
  .seaction-header-main { overflow: hidden !important; position: relative; }
  .seaction-header-main::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 55%;
    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.75) 60%, rgba(0,0,0,0.9));
    pointer-events: none;
    z-index: 1;
  }
  .contact_full { padding: 2rem 1rem; border-radius: 16px; }
  .section_contact .padding-global-4 { padding-left: 0.75rem !important; padding-right: 0.75rem !important; }
}
@media (max-width: 479px) {
  .contact_full { padding: 1.75rem 0.75rem; }
  .section_contact .padding-global-4 { padding-left: 0.5rem !important; padding-right: 0.5rem !important; }
}

/* ---------- Latest Insights (blog) section ---------- */
.insights-section { padding: clamp(5rem, 10vw, 8rem) 0; background: #0a0208; color: #fff; }
.insights-section__container { max-width: 1240px; margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 3rem); }
.insights-section__header { text-align: center; max-width: 720px; margin: 0 auto 3.5rem; }
.insights-section__title { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; color: #fff; margin: 0 0 1rem; }
.insights-section__sub { font-size: 1rem; line-height: 1.6; color: rgba(255,255,255,0.65); margin: 0; }

/* Featured card (desktop) — dark red panel, no red glow */
.insights-featured { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 0; border-radius: 20px; overflow: hidden; text-decoration: none; color: inherit; background: linear-gradient(160deg, #4a0a15 0%, #2c060d 100%); border: 1px solid rgba(255,255,255,0.06); box-shadow: 0 20px 50px -25px rgba(0,0,0,0.6); position: relative; margin-bottom: 2rem; transition: transform 0.35s ease, box-shadow 0.35s ease; }
.insights-featured:hover { transform: translateY(-4px); box-shadow: 0 28px 60px -25px rgba(0,0,0,0.7); }
.insights-featured__media { position: relative; overflow: hidden; background: #13111a; min-height: 320px; }
.insights-featured__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
.insights-featured:hover .insights-featured__img { transform: scale(1.03); }
.insights-featured__panel { padding: clamp(1.75rem, 3vw, 2.75rem); display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; position: relative; }
.insights-featured__tag { align-self: flex-start; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700; padding: 0.4rem 0.85rem; border-radius: 999px; background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.2); }
.insights-featured__title { font-size: clamp(1.4rem, 2.2vw, 1.9rem); line-height: 1.2; letter-spacing: -0.01em; color: #fff; font-weight: 700; margin: 0; }
.insights-featured__desc { font-size: 1rem; line-height: 1.6; color: rgba(255,255,255,0.7); margin: 0; }
.insights-featured__author { display: flex; align-items: center; gap: 0.85rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.08); }
.insights-featured__avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, #ff2e4d, #ff6a3d); display: inline-flex; align-items: center; justify-content: center; font-size: 0.78rem; font-weight: 700; color: #fff; letter-spacing: 0.05em; }
.insights-featured__author-meta { display: flex; flex-direction: column; gap: 0.1rem; }
.insights-featured__author-name { color: #fff; font-weight: 600; font-size: 0.95rem; }
.insights-featured__author-role { color: rgba(255,255,255,0.55); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; }

/* Three tiles row (desktop) */
.insights-tiles { display: grid; gap: 1.5rem; }
.insights-tiles--desktop { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.insights-tiles--mobile { display: none; grid-template-columns: 1fr; }

.insights-tile { position: relative; display: block; aspect-ratio: 4/3; overflow: hidden; text-decoration: none; color: inherit; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08); background: #13111a; transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
.insights-tile:hover { transform: translateY(-3px); border-color: rgba(255,255,255,0.18); box-shadow: 0 20px 50px -25px rgba(0,0,0,0.7); }
.insights-tile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
.insights-tile:hover .insights-tile__img { transform: scale(1.05); }
.insights-tile__scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.55) 75%, rgba(0,0,0,0.85) 100%); pointer-events: none; }
