  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6a576ec01f9b918f8374cd15" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="/js/webflow.js" type="text/javascript"></script>
  <script is:inline>
    (function () {
      const form = document.getElementById("contact-form");
      const result = document.getElementById("contact-form-result");
      if (!form || !result) return;
      const submit = form.querySelector('button[type="submit"]');

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;

        result.dataset.state = "";
        result.textContent = "Sending…";
        if (submit) submit.disabled = true;

        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: { Accept: "application/json" },
            body: new FormData(form),
          });
          const data = await response.json();
          if (data.success) {
            result.dataset.state = "success";
            result.textContent = "Thanks — redirecting…";
            window.location.href = "/thank-you/";
          } else {
            result.dataset.state = "error";
            result.textContent = data.message || "Something went wrong. Please try again.";
            if (submit) submit.disabled = false;
          }
        } catch (err) {
          result.dataset.state = "error";
          result.textContent = "Network error. Please try again.";
          if (submit) submit.disabled = false;
        }
      });
    })();
  </script>
