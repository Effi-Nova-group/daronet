---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.publishDate.toLocaleDateString('en-AU', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---

<Base title={`${post.data.title} — Daronet`} description={post.data.description}>
  <article class="post">
    <div class="post__container">
      <a href="/blog" class="post__back">← All insights</a>

      <header class="post__header">
        <span class="post__tag">{post.data.tag}</span>
        <h1 class="post__title">{post.data.title}</h1>
        <p class="post__desc">{post.data.description}</p>
        <div class="post__meta">
          <div class="post__author">
            <span class="post__author-name">{post.data.author}</span>
            <span class="post__author-role">{post.data.authorRole}</span>
          </div>
          <span class="post__date">{formattedDate}</span>
        </div>
      </header>

      <div class="post__hero">
        <Image src={post.data.image} alt={post.data.title} widths={[600, 1200, 1800]} sizes="(min-width: 1200px) 1120px, 100vw" class="post__hero-img" />
      </div>

      <div class="post__body">
        <Content />
      </div>

      <div class="post__cta">
        <p class="post__cta-text">Ready to modernise your enterprise stack?</p>
        <div class="button-primary-gradient header-button">
          <a href="/#contact" class="button-primary small-v2 w-button">Book a Strategy Call</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  :root {
    --accent-red: #ff2e4d;
    --accent-red-2: #ff6a3d;
  }
  .post { padding: clamp(5rem, 10vw, 8rem) 0 clamp(4rem, 8vw, 6rem); background: #0a0208; color: #fff; }
  .post__container { max-width: 820px; margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 2.5rem); }
  .post__back { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.15em; color: rgba(255,255,255,0.6); text-decoration: none; margin-bottom: 2.5rem; transition: color 0.2s ease; }
  .post__back:hover { color: var(--accent-red); }

  .post__header { margin-bottom: 2.5rem; }
  .post__tag { display: inline-block; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700; padding: 0.4rem 0.85rem; border-radius: 999px; background: rgba(255,46,77,0.12); color: var(--accent-red); border: 1px solid rgba(255,46,77,0.35); margin-bottom: 1.25rem; }
  .post__title { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -0.02em; font-weight: 700; color: #fff; margin: 0 0 1rem; }
  .post__desc { font-size: 1.15rem; line-height: 1.55; color: rgba(255,255,255,0.7); margin: 0 0 1.75rem; }
  .post__meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.08); flex-wrap: wrap; }
  .post__author { display: flex; flex-direction: column; gap: 0.1rem; }
  .post__author-name { color: #fff; font-weight: 600; font-size: 0.95rem; }
  .post__author-role { color: rgba(255,255,255,0.55); font-size: 0.82rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .post__date { color: rgba(255,255,255,0.55); font-size: 0.88rem; }

  .post__hero { border-radius: 16px; overflow: hidden; margin-bottom: 3rem; border: 1px solid rgba(255,255,255,0.08); background: #13111a; }
  .post__hero-img { width: 100%; height: auto; display: block; }

  /* Article body typography */
  .post__body { font-size: 1.05rem; line-height: 1.75; color: rgba(255,255,255,0.82); }
  .post__body :global(p) { margin: 0 0 1.35rem; }
  .post__body :global(h2) { font-size: clamp(1.4rem, 3vw, 1.85rem); line-height: 1.25; letter-spacing: -0.01em; color: #fff; margin: 2.5rem 0 1rem; font-weight: 700; }
  .post__body :global(h3) { font-size: clamp(1.15rem, 2.4vw, 1.35rem); line-height: 1.3; color: #fff; margin: 2rem 0 0.75rem; font-weight: 700; }
  .post__body :global(ul), .post__body :global(ol) { margin: 0 0 1.5rem; padding-left: 1.35rem; }
  .post__body :global(li) { margin: 0 0 0.65rem; }
  .post__body :global(li)::marker { color: var(--accent-red); }
  .post__body :global(strong) { color: #fff; font-weight: 700; }
  .post__body :global(a) { color: var(--accent-red); text-decoration: underline; text-underline-offset: 3px; }
  .post__body :global(a:hover) { color: var(--accent-red-2); }
  .post__body :global(blockquote) { border-left: 3px solid var(--accent-red); padding-left: 1.25rem; margin: 1.5rem 0; color: rgba(255,255,255,0.75); font-style: italic; }
  .post__body :global(code) { background: rgba(255,255,255,0.08); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.92em; }

  .post__cta { margin-top: 4rem; padding: 2.5rem; border-radius: 18px; background: linear-gradient(180deg, rgba(20,4,8,0.85), rgba(10,2,4,0.9)); border: 1px solid rgba(255,255,255,0.08); text-align: center; position: relative; overflow: hidden; }
  .post__cta::before { content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; background: linear-gradient(140deg, rgba(255,46,77,0.5), rgba(255,106,61,0.3), transparent 60%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
  .post__cta-text { position: relative; z-index: 1; font-size: 1.1rem; color: rgba(255,255,255,0.85); margin: 0 0 1.5rem; }
  .post__cta .button-primary-gradient { position: relative; z-index: 1; }
</style>
