---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);

// With no hero, the logo carries the hero slot - so don't also repeat it in the header.
const heroIsLogo = !study.data.heroImage && !!study.data.logo;

const formattedDate = study.data.publishedAt.toLocaleDateString('en-AU', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const siteBase = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: study.data.title,
  description: study.data.metaDescription,
  about: { '@type': 'Organization', name: study.data.client },
  articleSection: study.data.sector,
  datePublished: study.data.publishedAt.toISOString(),
  url: new URL(`/case-studies/${study.id}/`, siteBase).toString(),
  mainEntityOfPage: new URL(`/case-studies/${study.id}/`, siteBase).toString(),
  publisher: { '@type': 'Organization', name: 'Daronet' },
  ...(study.data.heroImage ? { image: new URL(study.data.heroImage.src, siteBase).toString() } : {}),
};
---

<Base title={study.data.metaTitle} description={study.data.metaDescription}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <article class="cs">
    <div class="cs__container">
      <a href="/case-studies" class="cs__back">← All case studies</a>

      <header class="cs__header">
        <span class="cs__sector">{study.data.sector}</span>
        <h1 class="cs__title">{study.data.title}</h1>
        <p class="cs__subtitle">{study.data.subtitle}</p>

        <div class="cs__meta">
          {study.data.logo && !heroIsLogo && (
            <span class="cs__logo-chip">
              <Image
                src={study.data.logo}
                alt={`${study.data.client} logo`}
                widths={[160, 320]}
                sizes="140px"
                class="cs__logo"
              />
            </span>
          )}
          <span class="cs__date">{formattedDate}</span>
        </div>
      </header>

      {study.data.stats.length > 0 && (
        <div class="cs__metrics">
          {study.data.stats.map((stat) => (
            <div class="cs__metric">
              <span class="cs__metric-value">{stat.value}</span>
              <span class="cs__metric-label">{stat.label}</span>
            </div>
          ))}
        </div>
      )}

      <div class="cs__hero">
        {study.data.heroImage ? (
          <Image
            src={study.data.heroImage}
            alt={`${study.data.client} campaign work`}
            widths={[600, 1200, 1800]}
            sizes="(min-width: 1200px) 1120px, 100vw"
            class="cs__hero-img"
          />
        ) : heroIsLogo ? (
          <div class="cs__hero-plate">
            <Image
              src={study.data.logo!}
              alt={`${study.data.client} logo`}
              widths={[600, 1200]}
              sizes="(min-width: 1200px) 1120px, 100vw"
              class="cs__hero-plate-img"
            />
          </div>
        ) : (
          <div class="cs__hero-fallback" aria-hidden="true">
            <span class="cs__hero-fallback-mark">{study.data.client}</span>
          </div>
        )}
      </div>

      <div class="cs__body">
        <Content />
      </div>

      <div class="cs__cta">
        <h2 class="cs__cta-heading">{study.data.ctaHeading}</h2>
        <p class="cs__cta-body">{study.data.ctaBody}</p>
        <div class="button-primary-gradient header-button">
          <a href="/#contact" class="button-primary small-v2 w-button">Book a Strategy Call</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  :root {
    --accent-red: #ff2e4d;
    --accent-red-2: #ff6a3d;
  }
  .cs { padding: clamp(5rem, 10vw, 8rem) 0 clamp(4rem, 8vw, 6rem); background: #0a0208; color: #fff; }

  /* The header is position:absolute over the top of the page and is taller on
     mobile than desktop - the 53px hamburger plus its padding - which left the
     back link underneath it. Clear it at each of the header's own breakpoints. */
  @media (max-width: 991px) { .cs { padding-top: 10rem; } }  /* header ~113px */
  @media (max-width: 767px) { .cs { padding-top: 9.5rem; } } /* header ~103px */
  @media (max-width: 479px) { .cs { padding-top: 9rem; } }   /* header ~95px  */
  .cs__container { max-width: 1120px; margin: 0 auto; padding: 0 clamp(1.25rem, 4vw, 2.5rem); }
  .cs__back { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.15em; color: rgba(255,255,255,0.6); text-decoration: none; margin-bottom: 2.5rem; transition: color 0.2s ease; }
  .cs__back:hover { color: var(--accent-red); }

  .cs__header { margin-bottom: 2.5rem; max-width: 920px; }
  .cs__sector { display: inline-block; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700; padding: 0.4rem 0.85rem; border-radius: 999px; background: rgba(255,46,77,0.12); color: var(--accent-red); border: 1px solid rgba(255,46,77,0.35); margin-bottom: 1.25rem; }
  .cs__title { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -0.02em; font-weight: 700; color: #fff; margin: 0 0 1rem; }
  .cs__subtitle { font-size: 1.15rem; line-height: 1.55; color: rgba(255,255,255,0.7); margin: 0 0 1.75rem; }
  .cs__meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,0.08); flex-wrap: wrap; }
  .cs__date { color: rgba(255,255,255,0.55); font-size: 0.88rem; }

  /* Client logo on the case study page: centred and cover-fitted. The box aspect
     (1.43) sits between the two logos that use it, so cover crops nothing visible. */
  .cs__logo-chip {
    display: block;
    width: 120px; height: 84px;
    background: #fff; border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 28px -14px rgba(0,0,0,0.8);
  }
  .cs__logo {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
  }

  /* Flexbox, not grid auto-fit: with repeat(auto-fit, minmax(160px, 240px)) the
     repetition count comes from the MAX track size, which collapses to one column
     on mobile and stretches a lone stat full width. This handles 1-4 stats cleanly. */
  .cs__metrics {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem;
    margin: 0 0 3rem;
  }
  .cs__metric {
    flex: 1 1 160px; max-width: 240px;
    display: flex; flex-direction: column; align-items: center; gap: 0.35rem;
    padding: 1.4rem 1rem;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(20,4,8,0.85), rgba(10,2,4,0.9));
    border: 1px solid rgba(255,46,77,0.28);
  }
  .cs__metric-value { font-size: clamp(1.75rem, 4vw, 2.4rem); font-weight: 700; line-height: 1; letter-spacing: -0.02em; color: #fff; }
  .cs__metric-label { font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.6); text-align: center; }

  .cs__hero { border-radius: 16px; overflow: hidden; margin-bottom: 3rem; border: 1px solid rgba(255,255,255,0.08); background: #13111a; }
  .cs__hero-img { width: 100%; height: auto; display: block; }
  /* No campaign imagery for this study - the client logo fills the hero slot,
     centred and cover-fitted. */
  .cs__hero-plate { aspect-ratio: 16/9; overflow: hidden; }
  .cs__hero-plate-img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
  }

  .cs__hero-fallback {
    aspect-ratio: 16/8; display: grid; place-items: center;
    background:
      radial-gradient(120% 100% at 15% 0%, rgba(255,46,77,0.35), transparent 60%),
      radial-gradient(120% 120% at 100% 100%, rgba(255,106,61,0.25), transparent 55%),
      linear-gradient(140deg, #1a0610, #0a0208);
  }
  .cs__hero-fallback-mark { font-size: clamp(1.5rem, 5vw, 2.75rem); font-weight: 700; letter-spacing: -0.02em; color: rgba(255,255,255,0.22); text-align: center; padding: 0 1.5rem; }

  /* Article body typography - mirrors .post__body on the blog */
  /* Container is 1120px so the hero, metrics and header get room; the prose
     itself stays at a readable measure rather than running the full width. */
  .cs__body { font-size: 1.08rem; line-height: 1.75; color: rgba(255,255,255,0.82); max-width: 920px; margin: 0 auto; }
  .cs__body :global(p) { margin: 0 0 1.35rem; }
  .cs__body :global(h2) { font-size: clamp(1.4rem, 3vw, 1.85rem); line-height: 1.25; letter-spacing: -0.01em; color: #fff; margin: 2.5rem 0 1rem; font-weight: 700; }
  .cs__body :global(h3) { font-size: clamp(1.15rem, 2.4vw, 1.35rem); line-height: 1.3; color: #fff; margin: 2rem 0 0.75rem; font-weight: 700; }
  .cs__body :global(h4) { font-size: 1.05rem; line-height: 1.35; color: #fff; margin: 1.75rem 0 0.6rem; font-weight: 700; }
  .cs__body :global(ul), .cs__body :global(ol) { margin: 0 0 1.5rem; padding-left: 1.35rem; }
  .cs__body :global(li) { margin: 0 0 0.65rem; }
  .cs__body :global(li)::marker { color: var(--accent-red); }
  .cs__body :global(strong) { color: #fff; font-weight: 700; }
  .cs__body :global(a) { color: var(--accent-red); text-decoration: underline; text-underline-offset: 3px; }
  .cs__body :global(a:hover) { color: var(--accent-red-2); }
  .cs__body :global(blockquote) { border-left: 3px solid var(--accent-red); padding-left: 1.25rem; margin: 1.5rem 0; color: rgba(255,255,255,0.75); font-style: italic; }

  .cs__cta { margin-top: 4rem; padding: 2.5rem; border-radius: 18px; background: linear-gradient(180deg, rgba(20,4,8,0.85), rgba(10,2,4,0.9)); border: 1px solid rgba(255,255,255,0.08); text-align: center; position: relative; overflow: hidden; }
  .cs__cta::before { content: ""; position: absolute; inset: -1px; border-radius: inherit; padding: 1px; background: linear-gradient(140deg, rgba(255,46,77,0.5), rgba(255,106,61,0.3), transparent 60%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
  .cs__cta-heading { position: relative; z-index: 1; font-size: clamp(1.35rem, 3vw, 1.75rem); font-weight: 700; letter-spacing: -0.01em; color: #fff; margin: 0 0 0.85rem; }
  .cs__cta-body { position: relative; z-index: 1; font-size: 1.02rem; line-height: 1.6; color: rgba(255,255,255,0.72); margin: 0 auto 1.75rem; max-width: 52ch; }
  /* Override daronet.webflow.css mobile rule that hides .button-primary-gradient.header-button (intended for the nav variant only) */
  .cs__cta .button-primary-gradient.header-button { display: inline-block !important; position: relative; z-index: 1; }
</style>
